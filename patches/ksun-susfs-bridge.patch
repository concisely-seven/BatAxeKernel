From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Subject: [PATCH] kernel: integrate SUSFS with KernelSU-Next legacy

This patch targets KernelSU-Next legacy commit b933b1f728116a456fbebf27b6a8772a640cdf23.
It adds SUSFS Kconfig options, initializes SUSFS, and marks app tasks for SUSFS
without changing KernelSU's mount/unmount implementation.

---
 kernel/Kconfig                 | 78 ++++++++++++++++++++++++++++++++++++++++++
 kernel/core/init.c             |  7 +++++
 kernel/feature/kernel_umount.c | 15 ++++++--
 3 files changed, 97 insertions(+), 3 deletions(-)

diff --git a/kernel/Kconfig b/kernel/Kconfig
index 0000000..0000000 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -76,8 +76,93 @@ config KSU_SYSCALL_TABLE_HOOK
 	  Patch sys_call_table entries directly to hook syscalls without
 	  kprobes or tracepoints. Intended for non-GKI kernels where kprobes
 	  are unavailable or non-functional.
 	  Requires kernel >= 4.17 (pt_regs-based syscall ABI).
 
 endchoice
 
+config KSU_SUSFS
+	bool "KernelSU addon - SUSFS"
+	depends on KSU
+	default y
+
+config KSU_SUSFS_HAS_MAGIC_MOUNT
+	bool "KernelSU has Magic Mount support"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_SUS_PATH
+	bool "Hide suspicious paths"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_SUS_MOUNT
+	bool "Hide suspicious mounts"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+	bool "Automatically hide KernelSU default mounts"
+	depends on KSU_SUSFS_SUS_MOUNT
+	default y
+
+config KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+	bool "Automatically hide suspicious bind mounts"
+	depends on KSU_SUSFS_SUS_MOUNT
+	default y
+
+config KSU_SUSFS_SUS_KSTAT
+	bool "Spoof suspicious kstat data"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_SUS_MAP
+	bool "Spoof /proc maps"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_SUS_SU
+	bool "SUS_SU compatibility"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_SUS_OVERLAYFS
+	bool "Spoof overlayfs kstat and statfs"
+	depends on KSU_SUSFS
+	default n
+
+config KSU_SUSFS_TRY_UMOUNT
+	bool "Enable SUSFS try-umount support"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+	bool "Automatically add bind mounts to try-umount"
+	depends on KSU_SUSFS_TRY_UMOUNT
+	default y
+
+config KSU_SUSFS_SPOOF_UNAME
+	bool "Spoof uname"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_ENABLE_LOG
+	bool "Enable runtime SUSFS logging control"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+	bool "Hide KernelSU and SUSFS symbols from kallsyms"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	bool "Spoof proc cmdline or bootconfig"
+	depends on KSU_SUSFS
+	default y
+
+config KSU_SUSFS_OPEN_REDIRECT
+	bool "Redirect selected open paths"
+	depends on KSU_SUSFS
+	default y
+
 endmenu
diff --git a/kernel/core/init.c b/kernel/core/init.c
index 0000000..0000000 100644
--- a/kernel/core/init.c
+++ b/kernel/core/init.c
@@ -4,7 +4,10 @@
 #include <linux/module.h>
 #include <linux/rcupdate.h>
 #include <linux/sched.h>
 #include <linux/workqueue.h>
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs.h>
+#endif
 
 #include "preinit/preinit.h"
 #include "policy/allowlist.h"
@@ -105,6 +108,10 @@ int __init kernelsu_init(void)
 
 	ksu_feature_init();
 
+#ifdef CONFIG_KSU_SUSFS
+	susfs_init();
+#endif
+
 	ksu_sulog_init();
 
 	ksu_adb_root_init();
diff --git a/kernel/feature/kernel_umount.c b/kernel/feature/kernel_umount.c
index 0000000..0000000 100644
--- a/kernel/feature/kernel_umount.c
+++ b/kernel/feature/kernel_umount.c
@@ -9,6 +9,9 @@
 #include <linux/path.h>
 #include <linux/printk.h>
 #include <linux/types.h>
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs.h>
+#endif
 #ifndef KSU_HAS_PATH_UMOUNT
 #include <linux/syscalls.h>
 #endif
@@ -122,19 +125,6 @@ int ksu_handle_umount(uid_t old_uid, uid_t new_uid)
 {
 	struct umount_tw *tw;
 
-	// if there isn't any module mounted, just ignore it!
-	if (!ksu_module_mounted) {
-		return 0;
-	}
-
-	if (!ksu_kernel_umount_enabled) {
-		return 0;
-	}
-
-	if (!ksu_cred) {
-		return 0;
-	}
-
 	// There are 6 scenarios:
 	// 1. Normal app: zygote -> appuid
 	// 2. Isolated process forked from zygote: zygote -> isolated_process
@@ -145,7 +136,18 @@ int ksu_handle_umount(uid_t old_uid, uid_t new_uid)
 	if (!is_appuid(new_uid) && new_uid != WEBVIEW_ZYGOTE_UID && !is_isolated_process(new_uid)) {
 		return 0;
 	}
 
+#ifdef CONFIG_KSU_SUSFS
+	task_lock(current);
+	current->susfs_task_state |= TASK_STRUCT_NON_ROOT_USER_APP_PROC;
+	task_unlock(current);
+#endif
+
+	// Preserve KernelSU's original early-exit conditions after SUSFS task marking.
+	if (!ksu_module_mounted || !ksu_kernel_umount_enabled || !ksu_cred) {
+		return 0;
+	}
+
 	if (!ksu_uid_should_umount(new_uid) && !is_isolated_process(new_uid)) {
 		return 0;
 	}
