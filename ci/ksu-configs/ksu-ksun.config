# KernelSU Next legacy non-GKI for Samsung Exynos 9825 / Linux 4.14.113
# Kconfig symbol names must match KernelSU-Next/KernelSU-Next:legacy/kernel/Kconfig.
CONFIG_OVERLAY_FS=y
CONFIG_KSU=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_KSU_KPROBES_HOOK=y
# CONFIG_KSU_MANUAL_HOOK is not set
CONFIG_ANDROID_SAR_RAMDISK=y
CONFIG_ANDROID_BOOT_PARTITION="/dev/sda14"
